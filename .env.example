# Copy to .env.local and fill in your Supabase project values.
# The app requires Supabase for all surfaces (marketing, auth, dashboards).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer key name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (admin API routes, integration storage)
SUPABASE_SECRET_KEY=

# BLOB_READ_WRITE_TOKEN=

# Optional: override auth email redirect in local development
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:43123/auth/callback
