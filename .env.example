# Copy to .env.local and fill in your Supabase project values.
# The marketing site still loads without these; login, dashboards, and uploads need them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer key name used by this app:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: override the auth email redirect in local development
# NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:43123/auth/callback
